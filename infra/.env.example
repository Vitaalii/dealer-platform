# Окружение сервера платформы. Скопировать в infra/.env (chmod 600) и заполнить на сервере.
# В репозитории — только имена, без значений (корневой CLAUDE.md, «Секреты»).
# Пароли и ключи: каждый — отдельной командой `openssl rand -hex 32`, только hex
# (пароль NocoDB идёт в строку подключения, где другие символы ломают адрес).

# --- Общие ---
# Какие compose-файлы брать. Тест: compose.yaml:compose.test.yaml   Бой: compose.yaml
COMPOSE_FILE=
# test или prod
PLATFORM_ENV=
# Тест: dealers.autodc.org
PLATFORM_DOMAIN=
# Тест: n8n.dealers.autodc.org
N8N_DOMAIN=
# Тест: noco.dealers.autodc.org
NOCODB_DOMAIN=
# Почта владельца для писем Let's Encrypt о сертификатах
ACME_EMAIL=
# Часовой пояс для расписаний n8n, например Europe/Moscow
PLATFORM_TIMEZONE=

# --- PostgreSQL: пароли ролей (infra/postgres/init/10-roles.sh) ---
# Суперпользователь postgres
POSTGRES_PASSWORD=
# platform_admin — владелец базы platform, под ним идут миграции
PLATFORM_ADMIN_PASSWORD=
# platform_app — код платформы
PLATFORM_APP_PASSWORD=
# nocodb_src — NocoDB как внешний источник (правка catalog и content, platform_ro — только чтение)
NOCODB_SRC_PASSWORD=
# bot_app — бот (чтение catalog и content)
BOT_APP_PASSWORD=
# n8n_reader — n8n читает catalog и content
N8N_READER_PASSWORD=
# n8n — владелец служебной базы n8n
N8N_DB_PASSWORD=
# nocodb_meta — владелец служебной базы NocoDB
NOCODB_META_PASSWORD=

# --- n8n ---
# Ключ шифрования учётных данных n8n. Потеря = потеря всех сохранённых ключей в n8n: хранить копию у владельца
N8N_ENCRYPTION_KEY=

# --- NocoDB ---
# Секрет подписи входов NocoDB
NC_AUTH_JWT_SECRET=

# --- Почта (infra/README.md, раздел 14) ---
# Сервис отправки: postbox или log (log — письма не уходят, только запись в лог; на бою запрещён)
MAIL_PROVIDER=
# Адрес отправителя на подтверждённом в Postbox домене. Тест: no-reply@notify.dealers.autodc.org
MAIL_FROM=
# Имя отправителя. Тест: Платформа дилеров
MAIL_FROM_NAME=
# Не больше стольких писем в секунду (квота Postbox на старте — 1)
MAIL_MAX_PER_SECOND=
# Статический ключ сервисного аккаунта с ролью postbox.sender: идентификатор ключа
POSTBOX_KEY_ID=
# ... и секретный ключ
POSTBOX_SECRET_KEY=
# Адрес API Postbox: https://postbox.cloud.yandex.net
POSTBOX_ENDPOINT=
# Регион Postbox: ru-central1
POSTBOX_REGION=

# --- Бэкапы (infra/README.md, раздел 13) ---
# ВНИМАНИЕ: без паролей шифрования копии и дампы не расшифровать. Сохранить их копию вне сервера (менеджер паролей).
# Yandex Object Storage: имя бакета этого сервера (тест и бой — разные бакеты)
PGBACKREST_REPO1_S3_BUCKET=
# Статический ключ сервисного аккаунта с правами только на этот бакет: идентификатор ключа
PGBACKREST_REPO1_S3_KEY=
# ... и секретный ключ
PGBACKREST_REPO1_S3_KEY_SECRET=
# Пароль шифрования копий pgBackRest (openssl rand -hex 32)
PGBACKREST_REPO1_CIPHER_PASS=
# Пароль шифрования ежедневных дампов (openssl rand -hex 32)
DUMP_CIPHER_PASS=
# Сколько дней хранить дампы в хранилище; пусто = 30
DUMP_RETENTION_DAYS=
# Healthchecks.io: ping key проекта (в настройках проекта); пусто = сигналы не отправляются
HEALTHCHECKS_PING_KEY=
